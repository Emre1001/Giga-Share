{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Giga-Share",
  "mainBinaryName": "giga-share",
  "version": "2.0.2",
  "identifier": "io.github.emre1001.gigashare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Giga-Share",
        "width": 1120,
        "height": 740,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast file sharing over LAN or encrypted P2P",
    "longDescription": "Send files between Windows, Linux and Android — locally over Wi-Fi or worldwide via end-to-end encrypted P2P. No cloud, no accounts, no size limits.",
    "copyright": "GPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ],
        "section": "net"
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQkE1NjVCOUZENUJFNDQKUldSRXZ0V2ZXMWE2c0FTeUZ6cWdmck9SNENOaFRhTjUrWFh2MTFpYWVDWEdPdldMSG1KeXJPUkoK",
      "endpoints": [
        "https://github.com/Emre1001/Giga-Share/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
